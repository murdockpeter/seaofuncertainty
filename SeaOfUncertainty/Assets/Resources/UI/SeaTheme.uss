:root {
    color: rgb(221, 235, 241);
}

.app {
    flex-grow: 1;
    background-color: rgb(4, 14, 21);
    color: rgb(221, 235, 241);
    background-size: cover;
}

.topbar {
    height: 76px;
    min-height: 76px;
    flex-direction: row;
    align-items: center;
    padding-left: 24px;
    padding-right: 18px;
    background-color: rgba(7, 27, 38, 0.98);
    border-bottom-width: 1px;
    border-bottom-color: rgba(52, 155, 166, 0.5);
}

.brand { font-size: 27px; -unity-font-style: bold; color: rgb(238, 246, 248); }
.eyebrow { font-size: 11px; -unity-font-style: bold; color: rgb(238, 169, 63); letter-spacing: 2px; }
.heading { font-size: 31px; -unity-font-style: bold; color: white; }
.subheading { font-size: 18px; -unity-font-style: bold; color: white; }
.body-copy { font-size: 15px; color: rgb(199, 216, 222); white-space: normal; }
.muted { font-size: 12px; color: rgb(139, 169, 181); white-space: normal; }
.accent { color: rgb(78, 205, 215); }
.amber { color: rgb(241, 174, 65); }
.danger { color: rgb(243, 91, 79); }

.spacer { flex-grow: 1; }
.row { flex-direction: row; }
.column { flex-direction: column; }
.center { align-items: center; justify-content: center; }

.panel {
    background-color: rgba(8, 34, 45, 0.96);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(52, 139, 150, 0.45);
    border-right-color: rgba(52, 139, 150, 0.28);
    border-bottom-color: rgba(52, 139, 150, 0.28);
    border-left-color: rgba(52, 139, 150, 0.28);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding: 14px;
}

.button {
    height: 42px;
    min-width: 118px;
    margin: 4px;
    background-color: rgb(13, 57, 70);
    color: rgb(217, 235, 240);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 2px;
    border-left-width: 1px;
    border-top-color: rgba(66, 176, 188, 0.45);
    border-right-color: rgba(66, 176, 188, 0.35);
    border-bottom-color: rgb(45, 164, 177);
    border-left-color: rgba(66, 176, 188, 0.35);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    -unity-font-style: bold;
}
.button:hover, .button:focus { background-color: rgb(18, 91, 104); color: white; }
.button.primary { background-color: rgb(17, 112, 121); border-bottom-color: rgb(102, 233, 226); }
.button.warning { background-color: rgb(123, 64, 22); border-bottom-color: rgb(240, 165, 56); }
.button.danger-button { background-color: rgb(102, 35, 34); border-bottom-color: rgb(234, 79, 70); }
.button.selected { background-color: rgb(19, 126, 133); color: white; }

.workspace { flex-grow: 1; flex-direction: row; padding: 10px; min-height: 0; }
.timeline { width: 235px; min-width: 215px; margin-right: 10px; padding: 12px; overflow: hidden; }
.map-column { flex-grow: 1; min-width: 500px; position: relative; }
.dossier { width: 310px; min-width: 275px; margin-left: 10px; padding: 12px; overflow: hidden; }
.dossier-scroll { flex-grow: 1; }
.dossier-summary { margin-top: 7px; padding-top: 5px; border-top-width: 1px; border-top-color: rgba(52, 139, 150, 0.28); }
.bottom-deck { height: 225px; min-height: 205px; flex-direction: row; padding: 0 10px 10px 10px; }
.command-dock { height: 205px; min-height: 185px; }
.command-dock .actions { margin-right: 0; }
.actions { flex-grow: 1; min-width: 570px; margin-right: 10px; padding: 10px 12px; overflow: hidden; }
.action-row { width: 100%; }
.action-row > .button { flex-grow: 1; min-width: 0; height: 38px; margin: 3px; }
.command-summary { height: 18px; }
.action-preview { font-size: 12px; }
.timeline-row {
    height: 56px;
    margin-top: 4px;
    min-width: 0;
    padding: 4px 8px;
    font-size: 12px;
    white-space: normal;
    -unity-text-align: middle-left;
    background-color: rgba(10, 54, 65, 0.78);
    border-left-width: 3px;
    border-left-color: rgba(83, 172, 183, 0.35);
}
.timeline-row:hover, .timeline-row:focus { background-color: rgb(14, 83, 92); }
.timeline-row.active { border-left-color: rgb(241, 174, 65); background-color: rgb(15, 76, 83); }

.badge {
    min-width: 38px;
    height: 30px;
    padding: 5px 8px;
    margin: 3px;
    background-color: rgba(23, 93, 103, 0.85);
    color: white;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    border-bottom-width: 2px;
    border-bottom-color: rgb(58, 186, 194);
}

.stat-grid { flex-direction: row; flex-wrap: wrap; }
.stat {
    width: 84px;
    height: 58px;
    margin: 3px;
    padding: 4px;
    background-color: rgb(9, 49, 59);
    border-bottom-width: 2px;
    border-bottom-color: rgb(54, 176, 186);
}
.stat-name { font-size: 10px; color: rgb(147, 184, 195); -unity-text-align: middle-center; }
.stat-value { font-size: 24px; color: white; -unity-font-style: bold; -unity-text-align: middle-center; }

.attached-effect {
    margin-top: 9px;
    padding: 10px;
    background-color: rgba(5, 25, 34, 0.96);
    border-left-width: 4px;
}
.attached-effect.friction { border-left-color: rgb(241, 166, 52); }
.attached-effect.disruption { border-left-color: rgb(173, 126, 229); }
.attached-effect.destruction { border-left-color: rgb(232, 66, 58); }
.entropy-card {
    margin-top: 18px;
    margin-bottom: 18px;
    padding: 24px;
    min-height: 280px;
    justify-content: center;
    background-color: rgb(5, 29, 40);
    border-left-width: 7px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
}
.entropy-card.friction { border-left-color: rgb(241, 166, 52); border-top-color: rgba(241, 166, 52, 0.55); border-right-color: rgba(241, 166, 52, 0.35); border-bottom-color: rgba(241, 166, 52, 0.35); }
.entropy-card.disruption { border-left-color: rgb(173, 126, 229); border-top-color: rgba(173, 126, 229, 0.55); border-right-color: rgba(173, 126, 229, 0.35); border-bottom-color: rgba(173, 126, 229, 0.35); }
.entropy-card.destruction { border-left-color: rgb(232, 66, 58); border-top-color: rgba(232, 66, 58, 0.55); border-right-color: rgba(232, 66, 58, 0.35); border-bottom-color: rgba(232, 66, 58, 0.35); }
.entropy-card-id { font-size: 18px; color: rgb(241, 174, 65); -unity-font-style: bold; letter-spacing: 2px; }
.entropy-effect { margin-top: 20px; margin-bottom: 14px; font-size: 22px; color: white; white-space: normal; }

.front-page { flex-grow: 1; align-items: center; justify-content: center; padding: 40px; }
.hero-card { width: 760px; max-width: 86%; padding: 34px; }
.scenario-card { width: 720px; max-width: 86%; padding: 28px; }
.scenario-list { width: 920px; max-width: 92%; max-height: 88%; }
.scenario-option { width: 860px; max-width: 96%; margin-bottom: 14px; }
.front-title { font-size: 50px; -unity-font-style: bold; color: white; white-space: normal; }

.overlay-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.78); align-items: center; justify-content: center; }
.overlay-shade.command-table-shade { background-color: rgba(0, 0, 0, 0.52); justify-content: flex-end; padding-bottom: 22px; }
.context-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 8, 12, 0.16); }
.orders-context {
    position: absolute;
    width: 408px;
    height: 680px;
    max-height: 92%;
    padding: 0;
    overflow: hidden;
    background-color: rgba(4, 24, 31, 0.985);
    border-top-color: rgb(241, 174, 65);
    border-right-color: rgba(241, 174, 65, 0.52);
    border-bottom-color: rgba(241, 174, 65, 0.52);
    border-left-color: rgba(241, 174, 65, 0.52);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}
.context-titlebar { height: 48px; min-height: 48px; padding: 7px 9px 7px 16px; align-items: center; background-color: rgb(7, 38, 47); }
.context-titlebar > .eyebrow { color: rgb(246, 186, 75); }
.context-close { width: 34px; min-width: 34px; height: 32px; margin: 0; padding: 0; font-size: 20px; background-color: rgba(20, 67, 76, 0.82); border-bottom-color: rgba(93, 191, 199, 0.65); }
.context-accent-rule { height: 3px; min-height: 3px; background-color: rgb(232, 158, 49); }
.context-scroll { flex-grow: 1; margin: 0; padding: 0; }
.context-scroll .unity-scroll-view__content-container { padding: 14px 16px 18px 16px; }
.context-scroll .button { width: 100%; min-width: 0; min-height: 42px; margin: 3px 0 3px 0; }
.context-identity { margin-bottom: 5px; padding: 12px; background-color: rgba(10, 48, 57, 0.88); border-left-width: 3px; border-left-color: rgb(75, 205, 214); border-bottom-width: 1px; border-bottom-color: rgba(75, 205, 214, 0.28); }
.context-formation-name { margin-bottom: 4px; font-size: 24px; color: white; -unity-font-style: bold; white-space: normal; }
.context-chip-row { margin-top: 10px; flex-wrap: wrap; }
.context-chip { min-height: 24px; margin-right: 5px; margin-bottom: 3px; padding: 5px 8px; background-color: rgba(19, 81, 91, 0.92); color: rgb(211, 235, 237); border-bottom-width: 1px; border-bottom-color: rgb(64, 171, 182); border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; font-size: 9px; -unity-font-style: bold; }
.context-chip.mission { border-bottom-color: rgb(241, 174, 65); }
.context-chip.endurance { border-bottom-color: rgb(119, 201, 108); }
.context-section { height: 24px; min-height: 24px; margin-top: 13px; margin-bottom: 3px; padding-top: 5px; border-bottom-width: 1px; border-bottom-color: rgba(70, 156, 165, 0.28); }
.context-order-row { width: 100%; min-height: 48px; }
.context-order-row > .button { flex-grow: 1; width: auto; min-width: 0; margin: 3px; }
.context-utility { margin-top: 12px; background-color: rgba(14, 55, 61, 0.78); border-bottom-color: rgb(129, 201, 110); }
.modal { width: 760px; max-width: 88%; max-height: 88%; padding: 28px; }
.command-table {
    width: 1180px;
    max-width: 94%;
    height: 720px;
    max-height: 90%;
    padding: 24px 30px 20px 30px;
    background-color: rgba(7, 30, 36, 0.97);
    border-top-color: rgba(112, 186, 151, 0.62);
    border-right-color: rgba(112, 186, 151, 0.38);
    border-bottom-color: rgba(112, 186, 151, 0.38);
    border-left-color: rgba(112, 186, 151, 0.38);
}
.card-table-scroll { flex-grow: 1; margin-top: 14px; margin-bottom: 10px; }
.card-table-grid { flex-direction: row; flex-wrap: wrap; align-items: flex-start; justify-content: center; padding: 12px; }
.physical-card {
    width: 224px;
    min-width: 224px;
    height: 314px;
    margin: 8px;
    padding: 16px;
    background-color: rgb(18, 29, 31);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 7px;
    border-left-width: 2px;
    border-top-color: rgb(190, 155, 76);
    border-right-color: rgb(118, 91, 42);
    border-bottom-color: rgb(81, 57, 26);
    border-left-color: rgb(118, 91, 42);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}
.physical-card.response { background-color: rgb(20, 42, 37); border-top-color: rgb(129, 201, 110); border-right-color: rgb(68, 126, 77); border-bottom-color: rgb(45, 91, 57); border-left-color: rgb(68, 126, 77); }
.physical-card.friction { border-top-color: rgb(241, 166, 52); border-right-color: rgb(154, 94, 31); border-bottom-color: rgb(102, 57, 20); border-left-color: rgb(154, 94, 31); }
.physical-card.disruption { border-top-color: rgb(173, 126, 229); border-right-color: rgb(106, 74, 157); border-bottom-color: rgb(70, 46, 108); border-left-color: rgb(106, 74, 157); }
.physical-card.destruction { border-top-color: rgb(232, 66, 58); border-right-color: rgb(145, 45, 43); border-bottom-color: rgb(92, 29, 29); border-left-color: rgb(145, 45, 43); }
.physical-card:hover { translate: 0 -5px; background-color: rgb(24, 51, 50); }
.physical-card-id { font-size: 11px; color: rgb(241, 184, 80); -unity-font-style: bold; letter-spacing: 1px; }
.physical-card-title { min-height: 52px; margin-top: 9px; font-size: 20px; color: white; -unity-font-style: bold; white-space: normal; }
.physical-card-effect { flex-grow: 1; margin-top: 12px; font-size: 14px; color: rgb(215, 227, 224); white-space: normal; }
.physical-card-cost { min-height: 36px; margin-top: 8px; font-size: 11px; color: rgb(241, 184, 80); -unity-font-style: bold; white-space: normal; }
.physical-card-rule { height: 1px; margin-top: 8px; margin-bottom: 8px; background-color: rgba(185, 213, 196, 0.28); }
.physical-card-owner { min-height: 30px; font-size: 9px; color: rgb(142, 176, 163); -unity-font-style: bold; white-space: normal; }
.physical-card-action { width: 100%; min-width: 0; height: 38px; margin: 9px 0 0 0; font-size: 11px; }
.empty-hand { width: 520px; max-width: 90%; margin-top: 80px; padding: 30px; align-items: center; background-color: rgba(5, 22, 27, 0.74); border-top-width: 1px; border-bottom-width: 1px; border-top-color: rgba(112, 186, 151, 0.35); border-bottom-color: rgba(112, 186, 151, 0.35); }
.table-access { border-bottom-color: rgb(129, 201, 110); }
.map-hud-toggle {
    position: absolute;
    right: 14px;
    top: 50px;
    min-width: 184px;
    height: 34px;
    background-color: rgba(5, 29, 37, 0.88);
    border-bottom-color: rgb(129, 201, 110);
    font-size: 10px;
}
.hud-hidden > .topbar { display: none; }
.hud-hidden > .bottom-deck { display: none; }
.hud-hidden > .audio-description { display: none; }
.hud-hidden .workspace { padding: 0; }
.hud-hidden .timeline, .hud-hidden .dossier, .hud-hidden .map-help { display: none; }
.hud-hidden .map { border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; }
.hud-hidden .map-hud-toggle { top: 46px; right: 12px; }
.scroll { flex-grow: 1; }
.feedback-field { height: 92px; margin: 5px; background-color: rgb(5, 29, 37); color: white; }
.settings-scroll { flex-grow: 1; }
.settings-scroll > .eyebrow { margin-top: 12px; }
.audio-description {
    min-height: 28px;
    padding: 6px 18px;
    background-color: rgb(2, 20, 29);
    color: rgb(226, 236, 155);
    font-size: 12px;
    -unity-text-align: middle-center;
    border-top-width: 1px;
    border-top-color: rgba(226, 236, 155, 0.45);
}

.map {
    flex-grow: 1;
    min-height: 390px;
    overflow: hidden;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(61, 178, 188, 0.55);
    border-right-color: rgba(61, 178, 188, 0.35);
    border-bottom-color: rgba(61, 178, 188, 0.35);
    border-left-color: rgba(61, 178, 188, 0.35);
    background-size: cover;
}
.map-command-hud {
    position: absolute;
    left: 10px;
    top: 10px;
    right: 10px;
    height: 34px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}
.map-readout, .map-heading {
    height: 28px;
    padding: 6px 10px;
    background-color: rgba(3, 22, 31, 0.88);
    color: rgb(202, 230, 235);
    border-bottom-width: 1px;
    border-bottom-color: rgb(45, 164, 177);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    font-size: 11px;
    -unity-font-style: bold;
}
.map-marker { position: absolute; width: 54px; height: 42px; background-color: rgba(5, 35, 43, 0.95); color: white; -unity-text-align: middle-center; -unity-font-style: bold; border-left-width: 4px; }
.map-marker.blue { border-left-color: rgb(45, 177, 211); }
.map-marker.red { border-left-color: rgb(229, 71, 63); }
.map-marker.active-formation {
    width: 72px;
    height: 58px;
    margin-left: -9px;
    margin-top: -8px;
    background-color: rgba(91, 53, 9, 0.96);
    color: rgb(255, 228, 139);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 5px;
    border-top-color: rgb(255, 190, 54);
    border-right-color: rgb(255, 190, 54);
    border-bottom-color: rgb(255, 190, 54);
    border-left-color: rgb(255, 230, 136);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    font-size: 11px;
}
.map-marker.contact { width: 64px; height: 52px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-color: rgb(238, 126, 61); border-right-color: rgb(238, 126, 61); border-bottom-color: rgb(238, 126, 61); border-left-color: rgb(238, 126, 61); border-top-left-radius: 28px; border-top-right-radius: 28px; border-bottom-left-radius: 28px; border-bottom-right-radius: 28px; background-color: rgba(63, 25, 17, 0.68); }
.map-marker.eligible { border-top-color: rgb(75, 244, 177); border-right-color: rgb(75, 244, 177); border-bottom-color: rgb(75, 244, 177); border-left-color: rgb(75, 244, 177); }

.compact .dossier { display: none; }
.compact .timeline { width: 220px; min-width: 200px; }
.compact .brand { font-size: 21px; }
.short .bottom-deck { height: 205px; min-height: 190px; }
.short .timeline-row { height: 52px; font-size: 11px; }

.high-contrast .blue-accent { color: rgb(34, 220, 255); }
.high-contrast .red-accent { color: rgb(255, 194, 25); }

.large-text .body-copy { font-size: 18px; }
.large-text .muted, .large-text .audio-description { font-size: 15px; }
.large-text .button, .large-text .timeline-row { font-size: 15px; }
.large-text .eyebrow, .large-text .stat-name { font-size: 13px; }
.large-text .subheading { font-size: 20px; }
.large-text .heading { font-size: 35px; }

.extra-large-text .body-copy { font-size: 21px; }
.extra-large-text .muted, .extra-large-text .audio-description { font-size: 18px; }
.extra-large-text .button, .extra-large-text .timeline-row { font-size: 18px; }
.extra-large-text .eyebrow, .extra-large-text .stat-name { font-size: 15px; }
.extra-large-text .subheading { font-size: 23px; }
.extra-large-text .heading { font-size: 39px; }
.large-text .modal, .extra-large-text .modal { max-height: 94%; }
